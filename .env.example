# Скопируйте в .env и подставьте свои значения. Не коммитьте .env.

# База. Пустые значения оставляют SQLite (./data/cargo.sqlite).
# Для MySQL задайте URL, драйвер и диалект.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER_CLASS_NAME=
DB_PATH=./data/cargo.sqlite
DB_USERNAME=
DB_PASSWORD=
DB_NAME=CargoDB
MYSQL_ROOT_PASSWORD=
HIBERNATE_DDL_AUTO=update
HIBERNATE_DIALECT=

# Почта
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# JWT. В проде задайте свою строку длиннее 32 символов.
JWT_SECRET=
JWT_EXPIRATION=86400000

# bePaid. Публичный ключ — PEM в одну строку или с \n.
BEPAID_SHOP_ID=
BEPAID_SECRET_KEY=
BEPAID_PUBLIC_KEY=
BEPAID_CHECKOUT_URL=https://checkout.bepaid.by/ctp/api/checkouts
BEPAID_RETURN_URL=https://fluvion.by/thanks
BEPAID_FAIL_URL=https://fluvion.by/badResponse
BEPAID_CALLBACK_URL=https://fluvion.by/api/payment/webhook
BEPAID_TEST_MODE=true

# Европочта
EUPOST_API_URL=https://api.eurotorg.by:10352/Json
EUPOST_SERVICE_NUMBER=
EUPOST_LOGIN=
EUPOST_PASSWORD=
